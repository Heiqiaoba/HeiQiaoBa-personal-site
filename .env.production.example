# 复制为 .env.production 后填写（该文件含密钥，已 gitignore）
# 站点域名（不带协议），Caddy 会自动为该域名申请 HTTPS 证书
DOMAIN=example.com

# 数据库
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=app

# Better Auth：必须是强随机值（openssl rand -base64 32）
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32

# 管理员用户 ID（可选，双保险；作者账号仍用 pnpm create-admin 创建）
ADMIN_USER_IDS=

# 生产默认关闭 API 文档；如需开启设 true 并设置 DOCS_TOKEN
ENABLE_DOCS=false
DOCS_TOKEN=

DB_POOL_MAX=20
LOG_LEVEL=info
