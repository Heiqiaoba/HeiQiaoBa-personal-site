# Server
PORT=3100
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174
DB_POOL_MAX=10
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app

# Auth (Better Auth) — 生产必须替换为强随机值：openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3100
ADMIN_USER_IDS=b7383fd8-5f82-4c5b-916c-9033c0b7296f

# API Docs（生产默认关闭；开启时建议设 DOCS_TOKEN）
ENABLE_DOCS=true
# DOCS_TOKEN=your-docs-access-token
